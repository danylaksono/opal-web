{
  "name": "opal-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Phase 0 feasibility harness for Opal Web, a client-side LaTeX workspace",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "spike:corpus": "tsx scripts/build-corpus-manifest.ts",
    "spike:coverage": "tsx scripts/check-bundle-coverage.ts",
    "spike:siglum": "tsx scripts/check-siglum-coverage.ts",
    "spike:corpus-run": "tsx scripts/run-corpus-spike.ts",
    "spike:perf": "tsx scripts/run-perf-spike.ts",
    "spike:firstload": "tsx scripts/run-firstload-spike.ts",
    "spike:tex-archive": "tsx scripts/build-tex-archive.ts",
    "spike:range-fetch": "tsx scripts/run-range-fetch-spike.ts",
    "spike:pinned-archive": "tsx scripts/build-pinned-archive.ts",
    "serve:tex-archive": "tsx scripts/serve-tex-archive.ts",
    "spike:texlive-index": "tsx scripts/build-texlive-index.ts",
    "spike:texlive-min": "tsx scripts/build-texlive-min.ts",
    "spike:brotli": "tsx scripts/build-brotli-assets.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@radix-ui/react-slot": "1.2.4",
    "@siglum/engine": "^0.1.4",
    "@tailwindcss/vite": "4.1.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "0.563.0",
    "mupdf": "^1.28.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-resizable-panels": "3.0.6",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.1.18",
    "texlyre-busytex": "^1.4.0",
    "tw-animate-css": "1.4.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.3.13",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@11.13.1"
}
