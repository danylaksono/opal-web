# Spike outputs. The corpus reference PDFs are NOT ignored: they are desktop
# Tectonic's output and cannot be regenerated without that repo and a working
# native toolchain, which makes them a baseline rather than a build artifact.
spike-results/
playwright-report/
test-results/

# Engine assets: 225 MB of third-party WASM and TeX Live bundles, fetched by
# scripts/download-siglum-assets.sh. Never committed; see docs/adr/003.
public/engines/

# Version-pinned CTAN package cache filled by the dev/preview proxy.
.cache/

# Indexed TeX archive, built from the engine bundles by pnpm spike:tex-archive.
# A build artifact of assets that are themselves downloaded (ADR-011).
public/tex/
