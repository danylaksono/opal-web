{
  "compilerOptions": {
    "target": "ES2023",
    // Playwright scripts contain page.evaluate bodies that run in the
    // browser, so DOM types are needed even though the host is Node.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts",
    // Build-time code is tested inside the build-time project: a test under
    // tests/unit belongs to the app project, and importing a script from there
    // crosses project boundaries.
    "tests/scripts"
  ]
}
